{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": null,
      "buildCommand": "echo Using prebuilt Flutter Web",
      "installCommand": "echo No frontend dependencies",
      "outputDirectory": "build/web"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.api.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
